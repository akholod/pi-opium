{
  "name": "pi-opium",
  "version": "0.1.1",
  "description": "Pi extension: oh-my-opencode-slim style orchestrator with its own background specialist agents and a multi-model council, on pi-agent-runner",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "orchestrator",
    "council"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "src",
    "agents",
    "defaults",
    "skills",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "lint": "eslint . && prettier --check \"**/*.ts\" \"**/*.json\" \"**/*.md\"",
    "fix": "eslint . --fix && prettier --write \"**/*.ts\" \"**/*.json\" \"**/*.md\"",
    "dev": "pi -e .",
    "test:live": "node --experimental-strip-types test/acceptance.live.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-metarhia": "^9.2.1",
    "prettier": "^3.0.0",
    "typebox": "^1.3.36",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "pi-agent-runner": "^0.4.0"
  }
}
