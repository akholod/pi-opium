{
  "name": "pi-opium",
  "version": "0.3.0",
  "description": "Turn your Pi session into a small team: an orchestrator with background specialist agents and a multi-model council",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "orchestrator",
    "subagents",
    "council"
  ],
  "author": "akholod",
  "license": "MIT",
  "homepage": "https://github.com/akholod/pi-opium#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akholod/pi-opium.git"
  },
  "bugs": {
    "url": "https://github.com/akholod/pi-opium/issues"
  },
  "type": "module",
  "files": [
    "extensions",
    "src",
    "agents",
    "defaults",
    "skills",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/akholod/pi-opium/main/assets/hero.webp"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "lint": "eslint . && prettier --check \"**/*.ts\" \"**/*.json\" \"**/*.md\"",
    "fix": "eslint . --fix && prettier --write \"**/*.ts\" \"**/*.json\" \"**/*.md\"",
    "dev": "pi -e .",
    "test:live": "node --experimental-strip-types test/acceptance.live.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "pi-agent-runner": "^0.8.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-metarhia": "^9.2.1",
    "prettier": "^3.0.0",
    "typebox": "^1.3.36",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1"
  }
}
